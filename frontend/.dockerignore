# Ignore all except build-relevant files
node_modules
.next
.env*
*.log
.git

# If using root context for individual Dockerfiles, 
# keep paths relative to this .dockerignore location.
# But for Coolify/Compose with subdirectories:
# **
# !package.json
# !tsconfig.json
# !next.config.ts
# !postcss.config.js
# !tailwind.config.cjs
# !src/**
# !public/**
